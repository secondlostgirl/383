# Copy this file to .env and fill in the values. Never commit .env.

# Backend
PORT=3001
# Relative to the repository root
DB_PATH=server/data/app.sqlite
# Required. Any long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI summary (M8): mock | live. Tests and CI always use mock.
AI_MODE=mock
# gemini | github-models
AI_PROVIDER=
AI_API_KEY=
